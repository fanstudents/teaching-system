    {
      "id": "el_wc04_explain2",
      "background": "#ffffff",
      "elements": [
        { "id": "el_wc04_t1", "type": "text", "x": 60, "y": 30, "width": 700, "height": 50, "content": "<b style=\"font-size:30px;color:#1e293b;\">🔍 解說：如何開始讓 AI 幫你工作？</b>", "fontSize": 30 },
        { "id": "el_wc04_s1", "type": "shape", "shapeType": "rectangle", "x": 60, "y": 78, "width": 50, "height": 3, "background": "#0284c7" },
        { "id": "el_wc04_s2", "type": "shape", "shapeType": "rectangle", "x": 60, "y": 110, "width": 840, "height": 65, "background": "#0f172a", "borderRadius": 12 },
        { "id": "el_wc04_t2", "type": "text", "x": 80, "y": 120, "width": 800, "height": 44, "content": "<div style=\"font-size:18px;color:#38bdf8;font-weight:700;\">🚀 三步驟開始使用 AI Agent</div>", "fontSize": 18 },
        { "id": "el_wc04_s3", "type": "shape", "shapeType": "rectangle", "x": 60, "y": 200, "width": 260, "height": 140, "background": "#f0f9ff", "borderRadius": 12 },
        { "id": "el_wc04_t3", "type": "text", "x": 78, "y": 210, "width": 224, "height": 120, "content": "<div style=\"font-size:15px;line-height:1.8;color:#0369a1;\"><b style=\"font-size:28px;\">1️⃣</b><br><b>拆解你的需求</b><br>把大任務拆成<br>小步驟清單</div>", "fontSize": 15 },
        { "id": "el_wc04_s4", "type": "shape", "shapeType": "rectangle", "x": 340, "y": 200, "width": 260, "height": 140, "background": "#faf5ff", "borderRadius": 12 },
        { "id": "el_wc04_t4", "type": "text", "x": 358, "y": 210, "width": 224, "height": 120, "content": "<div style=\"font-size:15px;line-height:1.8;color:#6d28d9;\"><b style=\"font-size:28px;\">2️⃣</b><br><b>選擇對的工具</b><br>ChatGPT / Claude<br>各有所長</div>", "fontSize": 15 },
        { "id": "el_wc04_s5", "type": "shape", "shapeType": "rectangle", "x": 620, "y": 200, "width": 260, "height": 140, "background": "#f0fdf4", "borderRadius": 12 },
        { "id": "el_wc04_t5", "type": "text", "x": 638, "y": 210, "width": 224, "height": 120, "content": "<div style=\"font-size:15px;line-height:1.8;color:#166534;\"><b style=\"font-size:28px;\">3️⃣</b><br><b>給出清楚指令</b><br>Prompt 是你<br>指揮 AI 的語言</div>", "fontSize": 15 },
        { "id": "el_wc04_t6", "type": "text", "x": 60, "y": 380, "width": 840, "height": 60, "content": "<div style=\"font-size:16px;line-height:2;color:#334155;\">💡 重點不是「AI 能做什麼」，而是<b style=\"color:#0284c7;\">「你能想到要 AI 做什麼」</b><br>能定義問題的人，就是能指揮 AI 的人。</div>", "fontSize": 16 }
      ]
    },
