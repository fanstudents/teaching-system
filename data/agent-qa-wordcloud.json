        { "id": "el_wc05_t1", "type": "text", "x": 60, "y": 30, "width": 700, "height": 50, "content": "<b style=\"font-size:30px;color:#1e293b;\">💬 Q&A：你對 AI Agent 最大的擔憂是什麼？</b>", "fontSize": 30 },
        { "id": "el_wc05_s1", "type": "shape", "shapeType": "rectangle", "x": 60, "y": 78, "width": 50, "height": 3, "background": "#dc2626" },
