    {
      "id": "el_wc06_explain3",
      "background": "#ffffff",
      "elements": [
        { "id": "el_wc06_t1", "type": "text", "x": 60, "y": 30, "width": 700, "height": 50, "content": "<b style=\"font-size:30px;color:#1e293b;\">🔍 解說：AI Agent 的風險與應對</b>", "fontSize": 30 },
        { "id": "el_wc06_s1", "type": "shape", "shapeType": "rectangle", "x": 60, "y": 78, "width": 50, "height": 3, "background": "#dc2626" },
        { "id": "el_wc06_s2", "type": "shape", "shapeType": "rectangle", "x": 60, "y": 110, "width": 410, "height": 120, "background": "#fef2f2", "borderRadius": 12 },
        { "id": "el_wc06_t2", "type": "text", "x": 78, "y": 118, "width": 374, "height": 100, "content": "<div style=\"font-size:15px;line-height:1.9;color:#991b1b;\"><b style=\"font-size:17px;\">⚠️ 常見擔憂</b><br>• 隱私洩露 — AI 能存取你的資料<br>• 取代工作 — 自動化衝擊就業<br>• 錯誤決策 — AI 判斷不一定正確</div>", "fontSize": 15 },
        { "id": "el_wc06_s3", "type": "shape", "shapeType": "rectangle", "x": 490, "y": 110, "width": 410, "height": 120, "background": "#f0fdf4", "borderRadius": 12 },
        { "id": "el_wc06_t3", "type": "text", "x": 508, "y": 118, "width": 374, "height": 100, "content": "<div style=\"font-size:15px;line-height:1.9;color:#166534;\"><b style=\"font-size:17px;\">✅ 正確心態</b><br>• 了解 AI 的邊界，不盲目信任<br>• 把 AI 當工具，不是老闆<br>• 持續學習，讓自己不可被取代</div>", "fontSize": 15 },
        { "id": "el_wc06_s4", "type": "shape", "shapeType": "rectangle", "x": 60, "y": 255, "width": 840, "height": 1, "background": "#e2e8f0" },
        { "id": "el_wc06_s5", "type": "shape", "shapeType": "rectangle", "x": 60, "y": 280, "width": 840, "height": 70, "background": "#0f172a", "borderRadius": 12 },
        { "id": "el_wc06_t4", "type": "text", "x": 80, "y": 290, "width": 800, "height": 50, "content": "<div style=\"font-size:20px;color:#fbbf24;font-weight:700;line-height:2;\">🎯 真正的威脅不是 AI 取代你<br>而是「會用 AI 的人」取代你</div>", "fontSize": 20 },
        { "id": "el_wc06_t5", "type": "text", "x": 60, "y": 390, "width": 840, "height": 60, "content": "<div style=\"font-size:16px;line-height:2;color:#334155;\">AI Agent 會出錯，所以更需要<b style=\"color:#dc2626;\">有判斷力的人來監督</b>。<br>未來最值錢的能力：<b style=\"color:#0284c7;\">人類判斷力 × AI 執行力</b></div>", "fontSize": 16 }
      ]
