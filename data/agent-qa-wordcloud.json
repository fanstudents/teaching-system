    {
      "id": "el_wc02_explain1",
      "background": "#ffffff",
      "elements": [
        { "id": "el_wc02_t1", "type": "text", "x": 60, "y": 30, "width": 700, "height": 50, "content": "<b style=\"font-size:30px;color:#1e293b;\">🔍 解說：AI Agent 最先改變的領域</b>", "fontSize": 30 },
        { "id": "el_wc02_s1", "type": "shape", "shapeType": "rectangle", "x": 60, "y": 78, "width": 50, "height": 3, "background": "#7c3aed" },
        { "id": "el_wc02_s2", "type": "shape", "shapeType": "rectangle", "x": 60, "y": 110, "width": 260, "height": 110, "background": "#faf5ff", "borderRadius": 12 },
        { "id": "el_wc02_t2", "type": "text", "x": 78, "y": 118, "width": 224, "height": 90, "content": "<div style=\"font-size:15px;line-height:1.8;color:#6d28d9;\"><b style=\"font-size:18px;\">📝 行政工作</b><br>報告、信件、排程<br>最容易被自動化</div>", "fontSize": 15 },
        { "id": "el_wc02_s3", "type": "shape", "shapeType": "rectangle", "x": 340, "y": 110, "width": 260, "height": 110, "background": "#f0f9ff", "borderRadius": 12 },
        { "id": "el_wc02_t3", "type": "text", "x": 358, "y": 118, "width": 224, "height": 90, "content": "<div style=\"font-size:15px;line-height:1.8;color:#0369a1;\"><b style=\"font-size:18px;\">💻 軟體開發</b><br>Vibe Coding 已開始<br>寫程式門檻快速降低</div>", "fontSize": 15 },
        { "id": "el_wc02_s4", "type": "shape", "shapeType": "rectangle", "x": 620, "y": 110, "width": 260, "height": 110, "background": "#f0fdf4", "borderRadius": 12 },
        { "id": "el_wc02_t4", "type": "text", "x": 638, "y": 118, "width": 224, "height": 90, "content": "<div style=\"font-size:15px;line-height:1.8;color:#166534;\"><b style=\"font-size:18px;\">📊 資料分析</b><br>搜尋、整理、報表<br>Agent 天生擅長</div>", "fontSize": 15 },
        { "id": "el_wc02_s5", "type": "shape", "shapeType": "rectangle", "x": 60, "y": 245, "width": 840, "height": 1, "background": "#e2e8f0" },
        { "id": "el_wc02_t5", "type": "text", "x": 60, "y": 270, "width": 840, "height": 90, "content": "<div style=\"font-size:16px;line-height:2;color:#334155;\">AI Agent 最先改變的，是那些<b style=\"color:#7c3aed;\">「重複性高、規則明確、可拆解成步驟」</b>的工作。<br><br>這不代表取代人類，而是<b style=\"color:#0284c7;\">讓人類從雜事中解放，去做更重要的事</b>。</div>", "fontSize": 16 },
        { "id": "el_wc02_t6", "type": "text", "x": 60, "y": 400, "width": 840, "height": 40, "content": "<div style=\"font-size:22px;color:#1e293b;\"><b>🎯 關鍵洞察：</b>未來最有價值的能力 = <b style=\"color:#7c3aed;\">拆解任務 + 指揮 AI</b></div>", "fontSize": 22 }
      ]
    },
